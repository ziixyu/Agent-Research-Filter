# Required: NCBI wants a contact email for Entrez API courtesy/rate-limiting.
# It is NOT validated against an account - any real-looking email works, but
# use your own so NCBI can reach you if you ever hammer their servers.
ENTREZ_EMAIL=you@example.com

# Optional: raises your NCBI rate limit from 3 req/s to 10 req/s. Get one free
# at https://www.ncbi.nlm.nih.gov/account/settings/ (not required for this demo).
ENTREZ_API_KEY=

# Required: Google AI Studio key for Gemini structured-output calls.
# Get one free at https://aistudio.google.com/apikey
GEMINI_API_KEY=
